{
  "name": "tikoci-website",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun run lint && bun run test && bun run build",
    "build": "bun run build.ts",
    "dev": "bun run build.ts && bun run serve",
    "serve": "bun --bun x serve dist -l 3000",
    "typecheck": "bunx tsc",
    "test": "bun test test/",
    "collect": "bun run scripts/collect.ts",
    "survey:pages": "bun run scripts/collect-pages.ts",
    "lint": "bunx tsc && bunx @biomejs/biome lint . && bun run lint:skills",
    "lint:skills": "markdownlint-cli2 \"skills/**/*.md\" && cspell lint \"skills/**\" --no-progress && bun scripts/check-skills.ts",
    "lint:fix": "bunx @biomejs/biome lint --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/bun": "^1.3.10",
    "@types/opentype.js": "^1.3.9",
    "cspell": "^10.0.0",
    "markdownlint-cli2": "^0.21.0",
    "opentype.js": "^1.3.4",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "curlconverter": "^4.12.0"
  }
}
