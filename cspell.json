{
	"version": "0.2",
	"language": "en",
	"enableGlobDot": true,
	"useGitignore": true,
	"minWordLength": 3,
	"flagWords": [
		"hte",
		"teh"
	],
	"ignorePaths": [
		"node_modules",
		"dist",
		".git",
		".scratch",
		"bun.lock",
		"docs/asset-migration.md"
	],
	"dictionaryDefinitions": [
		{
			"name": "project-words",
			"path": "./project-words.txt",
			"addWords": true
		}
	],
	"dictionaries": [
		"project-words"
	],
	"files": [
		"**/*.md"
	]
}
