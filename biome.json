{
    "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
    "files": {
        "includes": ["src/**/*.css", "src/**/*.js", "src/**/*.ts", "*.ts", "scripts/**/*.ts", "skills/**/*.ts", "data/*.ts", "tool/**/*.ts", "tool/**/*.js"]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "useAltText": "warn"
            }
        }
    },
    "formatter": {
        "enabled": false
    }
}
