{
  "version": "0.2",
  "language": "en",
  "enableGlobDot": true,
  "useGitignore": true,
  "minWordLength": 3,
  "files": ["**/*.md", "src/**/*.ts"],
  "ignorePaths": ["node_modules", "dist", "bun.lock", ".agents/skills/tikoci-*"],
  "flagWords": ["hte", "teh"],
  "ignoreWords": [],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"]
}
